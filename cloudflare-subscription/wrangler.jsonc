{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thekedaar-subscription-api",
  "main": "src/index.js",
  "compatibility_date": "2026-10-04",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "thekedaar-subscriptions",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ],
  "vars": {
    "ALLOWED_ORIGIN": "*"
  }
}